# Database (MySQL 8)
MYSQL_DATABASE=attendanceacspl
MYSQL_USER=acspluserattendance
MYSQL_PASSWORD=your-password-here
# MYSQL_HOST: localhost (native dev) | host.docker.internal (Docker → host MySQL) | your.server.ip
MYSQL_HOST=localhost
# In DATABASE_URL, URL-encode password (# → %23, @ → %40, etc.)
DATABASE_URL=mysql+aiomysql://acspluserattendance:YOUR_URL_ENCODED_PASSWORD@localhost:3306/attendanceacspl
DATABASE_URL_SYNC=mysql+pymysql://acspluserattendance:YOUR_URL_ENCODED_PASSWORD@localhost:3306/attendanceacspl
# Required when using docker compose for backend (external MySQL, no mysql container):
DATABASE_URL_DOCKER=mysql+aiomysql://acspluserattendance:YOUR_URL_ENCODED_PASSWORD@host.docker.internal:3306/attendanceacspl
DATABASE_URL_SYNC_DOCKER=mysql+pymysql://acspluserattendance:YOUR_URL_ENCODED_PASSWORD@host.docker.internal:3306/attendanceacspl

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Encryption
EMBEDDING_ENCRYPTION_KEY=change-me-fernet-key-base64

# Face recognition
MATCH_THRESHOLD=0.70
GRAY_ZONE_LOW=0.60
GRAY_ZONE_HIGH=0.65
DUPLICATE_WINDOW_SECONDS=300
RECOGNITION_SERVICE_URL=http://localhost:6003
DEEPFACE_ENABLED=false

# App
CORS_ORIGINS=http://localhost:6001
UPLOAD_DIR=./uploads
MIN_ENROLLMENT_IMAGES=5
MAX_ENROLLMENT_IMAGES=10

# SMTP notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
NOTIFY_FROM=attendance@company.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:6002
NEXT_PUBLIC_KIOSK_DEVICE_ID=kiosk-main-gate
NEXT_PUBLIC_KIOSK_API_KEY=
