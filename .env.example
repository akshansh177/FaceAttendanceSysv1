# Copy to apps/backend/.env and fill in your values.
# URL-encode special chars in passwords (# → %23, @ → %40).

DATABASE_URL=mysql+aiomysql://USER:PASS@localhost:3306/attendanceacspl
DATABASE_URL_SYNC=mysql+pymysql://USER:PASS@localhost:3306/attendanceacspl
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
EMBEDDING_ENCRYPTION_KEY=change-me-fernet-key-base64

MATCH_THRESHOLD=0.70
RECOGNITION_SERVICE_URL=http://localhost:6003
CORS_ORIGINS=http://localhost:6001
# Production CloudPanel: leave empty (uses /api on same domain)
# Dev: http://localhost:6002
NEXT_PUBLIC_API_URL=
