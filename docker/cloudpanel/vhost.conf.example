# CloudPanel reverse proxy — paste into your site's Nginx vhost (Vhost Editor).
# Replace attendance.akshanshconsultancy.com with your domain.
# Docker stack must use docker-compose.cloudpanel.yml (no container nginx/redis).

server {
    listen 80;
    listen [::]:80;
    server_name attendance.akshanshconsultancy.com;

    client_max_body_size 50M;

    location /api/ {
        proxy_pass http://127.0.0.1:6002;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /metrics {
        proxy_pass http://127.0.0.1:6002;
        proxy_set_header Host $host;    
    }

    location / {
        proxy_pass http://127.0.0.1:6001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# CloudPanel usually adds SSL via the panel; mirror the same location blocks on the :443 server {}
